# /etc/sekai-fanmade/app.env on ourtaiko-prod (root, 600). Never commit real values.
APP_ORIGIN=https://sekai.ourtaiko.org
# Own database and role in the shared ourtaiko-postgres instance (alias "postgres" on ourtaiko-shared).
DATABASE_URL=postgres://sekai_fanmade:<password>@postgres:5432/sekai_fanmade?sslmode=disable

SSO_ISSUER=https://sso.ourtaiko.org
SSO_CLIENT_ID=sekai-fanmade-prod
SSO_CLIENT_SECRET=<plain client secret from the SSO admin>
# Comma-separated SSO user IDs (32 hex) who may moderate every chart and comment.
ADMIN_USER_IDS=

# openssl rand -hex 32 ; changing it signs everyone out.
SESSION_ENCRYPTION_KEY=<64 hex>
SESSION_DAYS=7
SESSION_RECHECK_SECONDS=60

STORAGE_BACKEND=s3
S3_BUCKET=ourtaiko-public
S3_PREFIX=sekai-fanmade
AWS_REGION=ap-northeast-1
S3_PUBLIC_BASE_URL=https://distrib.ourtaiko.org/sekai-fanmade
# IAM user sekai-fanmade, inline policy limited to ourtaiko-public/sekai-fanmade/*
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

UPLOAD_MAX_MB=100
UPLOADS_PER_DAY=20
